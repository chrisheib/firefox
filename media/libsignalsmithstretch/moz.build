with Files("**"):
    BUG_COMPONENT = ("Core", "Audio/Video: Playback")

EXPORTS.signalsmith_stretch += [
    "include/signalsmith-stretch/signalsmith-stretch.h",
]

AllowCompilerWarnings()

LICENSES += ["signalsmith-stretch"]
LICENSES["signalsmith-stretch"].title = "Signalsmith Stretch License"
LICENSES["signalsmith-stretch"].text = "LICENSE.txt"
LICENSES["signalsmith-stretch"].notice = """
<p>This license applies to <code>media/libsignalsmithstretch/</code>.</p>
"""
LICENSED_UNDER += ["signalsmith-stretch"]
