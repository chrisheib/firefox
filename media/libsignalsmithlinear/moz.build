with Files("**"):
    BUG_COMPONENT = ("Core", "Audio/Video: Playback")

EXPORTS.signalsmith_linear += [
    "include/signalsmith-linear/approx.h",
    "include/signalsmith-linear/fft.h",
    "include/signalsmith-linear/linear.h",
    "include/signalsmith-linear/stft.h",
]

AllowCompilerWarnings()

LICENSES += ["signalsmith-linear"]
LICENSES["signalsmith-linear"].title = "Signalsmith Linear License"
LICENSES["signalsmith-linear"].text = "LICENSE.txt"
LICENSES["signalsmith-linear"].notice = """
<p>This license applies to <code>media/libsignalsmithlinear/</code>.</p>
"""
LICENSED_UNDER += ["signalsmith-linear"]
